# syntax=docker/dockerfile:1
# DeployForge control plane image (API + worker + built dashboard).
#
# Optional build secret `build_ca`: extra CA certificates for environments
# behind a TLS-intercepting proxy. It is used only while downloading
# dependencies and never stored in the image.
FROM node:22.22-alpine AS build
WORKDIR /src
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/contracts/package.json packages/contracts/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; \
    corepack enable && corepack prepare pnpm@10.33.0 --activate && pnpm install --frozen-lockfile
COPY packages/contracts packages/contracts
COPY apps/api apps/api
COPY apps/web apps/web
RUN pnpm --filter @deployforge/contracts build \
 && pnpm --filter @deployforge/api build \
 && pnpm --filter @deployforge/web build
RUN --mount=type=secret,id=build_ca,required=false \
    if [ -s /run/secrets/build_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/build_ca; fi; \
    pnpm --filter @deployforge/api deploy --prod --legacy /out

FROM node:22.22-alpine
ENV NODE_ENV=production WEB_DIST_DIR=/app/web
WORKDIR /app
COPY --from=build --chown=node:node /out/package.json ./package.json
COPY --from=build --chown=node:node /out/node_modules ./node_modules
COPY --from=build --chown=node:node /src/apps/api/dist ./dist
COPY --from=build --chown=node:node /src/apps/api/prisma ./prisma
COPY --from=build --chown=node:node /src/apps/api/prisma.config.ts ./prisma.config.ts
COPY --from=build --chown=node:node /src/apps/web/dist ./web
USER node
EXPOSE 3000
CMD ["node", "dist/main.js"]
