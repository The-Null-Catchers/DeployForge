# DeployForge configuration. Copy to .env with `pnpm setup` (or
# `node scripts/setup.mjs`), which generates every secret below. Values here
# are placeholders only — never commit a real .env.

# ---------------------------------------------------------------- general
NODE_ENV=production
# Public URL of the dashboard (used for cookies, redirects, invite links).
PUBLIC_URL=https://deployforge.example.com
# Hostname Caddy serves the dashboard on (must match PUBLIC_URL's host).
DASHBOARD_HOSTNAME=deployforge.example.com
DASHBOARD_UPSTREAM=api:3000
TRUST_PROXY=true

# ---------------------------------------------------------------- secrets
# One-time token required by the first-run setup page. Generated by setup.
SETUP_TOKEN=__generate__
# Signs native-client access tokens (>= 32 chars).
SESSION_SECRET=__generate__
# Master key(s) for encrypting environment variables at rest.
# Format: <id>:<base64 32 bytes>[,<id>:<base64>...]. KEEP A COPY OUTSIDE THIS
# SERVER: without it, encrypted variables in a restored database are unusable.
DEPLOYFORGE_MASTER_KEYS=__generate__
DEPLOYFORGE_ACTIVE_KEY_ID=k1
# Shared secret for HMAC-signed requests to the runner (>= 32 chars).
RUNNER_SHARED_SECRET=__generate__
# Token the worker uses to verify routing through Caddy's probe listener.
PROXY_PROBE_TOKEN=__generate__
POSTGRES_PASSWORD=__generate__

# ---------------------------------------------------------------- routing
# Applications are served at <slug>.<APPS_DOMAIN>. Point a wildcard DNS record
# *.APPS_DOMAIN at this server.
APPS_DOMAIN=apps.example.com
APPS_URL_SCHEME=https
# off: HTTP only (local development); internal: Caddy's local CA;
# acme: Let's Encrypt (production). ACME requires public DNS and ports 80/443.
TLS_MODE=acme
ACME_EMAIL=ops@example.com
# Optional: set to the ACME staging directory while testing to avoid rate limits
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Public IPv4 of this server, shown in DNS instructions for custom domains.
PUBLIC_IPV4=203.0.113.10
HTTP_PORT=80
HTTPS_PORT=443

# ---------------------------------------------------------------- engine
DEPLOY_WORKER_CONCURRENCY=4
RUNNER_MAX_CONCURRENT_BUILDS=2
BUILD_TIMEOUT_SECONDS=1200
DRAIN_SECONDS=15
RELEASES_TO_RETAIN=5
LOG_RETENTION_DAYS=14

# ---------------------------------------------------------------- GitHub App
# disabled | real  (see docs/github-app.md)
GITHUB_MODE=disabled
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# Path inside the container; mount the PEM read-only (see compose.yaml).
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
