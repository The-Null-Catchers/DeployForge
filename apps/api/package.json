{
  "name": "@deployforge/api",
  "version": "0.1.0",
  "private": true,
  "description": "DeployForge control plane: REST API, SSE, and background worker",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && DEPLOYFORGE_ENV_FILE=../../.env nest start --watch",
    "start:dev": "DEPLOYFORGE_ENV_FILE=../../.env node dist/main.js",
    "start": "node dist/main.js",
    "start:worker": "DEPLOYFORGE_PROCESS=worker node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "openapi": "node dist/scripts/export-openapi.js",
    "rotate-keys": "node dist/scripts/rotate-keys.js"
  },
  "dependencies": {
    "@deployforge/contracts": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "5.81.5",
    "cookie-parser": "1.4.7",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.12",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.0",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "4.1.11"
  }
}
